# =====================================================
# Daily Report Portal — Environment Variable Template
# Copy this file to `.env.local` and fill in real values.
# Do NOT commit `.env.local` (already git-ignored).
# =====================================================

# ---- App ----
NEXT_PUBLIC_APP_NAME="Daily Report Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database ----
DATABASE_URL=""

# ---- Authentication ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ---- Email / SMTP ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ---- Third-party API keys ----
API_KEY=""
